# Backend Environment Variables

# Application
APP_NAME=TempMail Pro
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# API
API_V1_PREFIX=/api/v1
ADMIN_PREFIX=/api/admin

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database
# For production use PostgreSQL:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tempmail
# For local development without PostgreSQL, use SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./tempmail.db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# SMTP (for receiving emails)
SMTP_HOST=localhost
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_TIMEOUT=30

# Email Generation
DEFAULT_DOMAINS=tempmail.pro,tmpmail.io,mailtemp.org
DEFAULT_TTL_HOURS=24
MAX_TTL_HOURS=168
MIN_TTL_HOURS=1
DEFAULT_MAX_EMAILS=100
MAX_EMAILS_PER_ADDRESS=1000

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_GENERATE_EMAIL=10
RATE_LIMIT_GENERATE_WINDOW=60

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Admin
ADMIN_EMAIL=admin@tempmail.local
ADMIN_PASSWORD=admin123
ADMIN_TOKEN_EXPIRE_MINUTES=10080

# Email Settings
EMAIL_MAX_SIZE=26214400
EMAIL_RETENTION_DAYS=7
MAX_ATTACHMENT_SIZE=10485760
ALLOWED_ATTACHMENT_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,text/plain,text/csv

# Spam
SPAM_CHECK_ENABLED=true
SPAM_THRESHOLD=5.0

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Sentry
SENTRY_DSN=

# WebSocket
WEBSOCKET_HEARTBEAT_INTERVAL=30
WEBSOCKET_MAX_CONNECTIONS=1000

# Inbox
EMAIL_CHECK_INTERVAL=2
MAX_INBOX_SIZE=1000