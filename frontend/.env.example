# Frontend Environment Variables

# In production (Vercel), leave these unset.
# The app defaults to same-origin URLs:
#   API:      /api/v1       (proxied to the backend service by vercel.json rewrites)
#   WebSocket: wss://<your-domain>/api/v1  (derived from window.location)
#
# Local development also works without them (the Vite dev server proxies /api
# to http://localhost:8000). Uncomment only to override.
# VITE_API_BASE_URL=/api/v1
# VITE_WS_URL=ws://localhost:3000/api/v1

# App
VITE_APP_NAME=TempMail Pro
